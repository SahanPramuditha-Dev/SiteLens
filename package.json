{
  "name": "sitelens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.verify.json --noEmit",
    "test": "node scripts/test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run build && node scripts/check.mjs",
    "package": "npm run check && node scripts/package.mjs",
    "test:ui": "node scripts/test-dashboard.mjs",
    "test:cli": "node scripts/test-cli.mjs"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "simple-icons": "^16.33.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zx": "^8.8.5"
  }
}
