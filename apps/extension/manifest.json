{
  "manifest_version": 3,
  "name": "SiteLens — Website Security Inspector",
  "version": "1.0.0",
  "minimum_chrome_version": "132",
  "incognito": "not_allowed",
  "description": "Evidence-first, passive website inspection with coverage, history and reports.",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "webNavigation"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Inspect with SiteLens", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"} },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
